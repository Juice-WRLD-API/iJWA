{
  "manifest_version": 3,
  "name": "iBaila",
  "version": "1.8.19",
  "description": "Lets iBaila on your computer play YouTube Music, SoundCloud and Spotify in this browser, right in your open tab, and show your playlists from them.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://music.youtube.com/*",
    "*://soundcloud.com/*",
    "*://m.soundcloud.com/*",
    "*://open.spotify.com/*"
  ],
  "minimum_chrome_version": "116",
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*",
        "*://soundcloud.com/*",
        "*://m.soundcloud.com/*",
        "*://open.spotify.com/*"
      ],
      "js": [
        "content/main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://music.youtube.com/*",
        "*://soundcloud.com/*",
        "*://m.soundcloud.com/*",
        "*://open.spotify.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
